# Copy this file to .env and set the real key locally. Do not commit .env.
IA_EMBEDDING_PROVIDER=polza
IA_EMBEDDING_MODEL=text-embedding-3-large
POLZA_AI_BASE_URL=https://polza.ai/api/v1
POLZA_AI_API_KEY=
POLZA_CHAT_BASE_URL=https://polza.ai/api/v1
POLZA_CHAT_MODEL=openai/gpt-4o-mini
IA_EMBEDDING_BATCH_SIZE=32
INSURANCE_ASSISTANT_RETRIEVAL_CANDIDATES=32
INSURANCE_ASSISTANT_RETRIEVAL_SEMANTIC_WEIGHT=1.0
INSURANCE_ASSISTANT_RETRIEVAL_LEXICAL_WEIGHT=1.0
INSURANCE_ASSISTANT_RETRIEVAL_MAX_PER_DOCUMENT=3
INSURANCE_ASSISTANT_CODEX_MODEL=
INSURANCE_ASSISTANT_CODEX_MODELS=gpt-5.6-terra
